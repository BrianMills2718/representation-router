    {
      "id": "semantic-zone-inspector",
      "actions": [
        {
          "type": "click",
          "selector": "#semantic-guide-grid .zone-meaning"
        }
      ]
    },
    {
      "id": "canonical",
      "actions": [
        {
          "type": "click",
          "selector": "#canonical"
        }
      ]
    }
  ],
  "screenshotDir": "../artifacts/numogram-render-qa",
  "screenshotEachState": false,
  "minimumRenderedTextHeightPx": 7.5,
  "maxTextOverlaps": 0,
  "maxPageHorizontalOverflowPx": 0
}
