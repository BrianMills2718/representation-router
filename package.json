  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "likec4": "^1.59.3",
    "puppeteer-core": "^25.10.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
