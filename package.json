  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "d3-force": "^3.0.0",
    "elkjs": "^0.9.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
