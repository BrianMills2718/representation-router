    "disposition": "node src/disposition-cli.mjs",
    "playground": "node scripts/serve.mjs",
    "render-qa": "node scripts/render-qa.mjs",
    "weekly-review": "vite --config weekly-review/vite.config.js",
    "build:weekly-review": "node scripts/build-weekly-review.mjs",
    "qa:weekly-review": "node scripts/render-qa.mjs weekly-review/render-qa.json",
    "build:company-review": "node scripts/build-company-review.mjs",
    "serve:company-review": "node scripts/serve-company-review.mjs",
    "build:review-workbench": "node scripts/build-review-workbench.mjs",
    "build:review-workbench:v1": "node scripts/build-review-workbench-v1.mjs",
    "build:review-workbench:v1.1": "vite build --config review-workbench-v11/vite.config.js",
    "build:review-workbench:v1.2": "vite build --config review-workbench-v12/vite.config.js",
    "build:review-workbench:v1.3": "vite build --config review-workbench-v13/vite.config.js",
    "build:review-workbench:v1.4": "vite build --config review-workbench-v14/vite.config.js",
    "build:feature-studio:v0": "vite build --config feature-studio-v0/vite.config.js",
    "build:engineering-studio:v1": "vite build --config engineering-studio-v1/vite.config.js",
