{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://representation-router.dev/schemas/use-case.schema.json",
  "title": "Representation Router Use Case",
  "type": "object",
  "required": [
    "id",
    "concern",
    "intent",
    "informationStructure",
    "tasks",
    "scale",
    "interaction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "description": "Optional short name for the page (a few words), shown as its title; concern keeps the full question.",
      "type": "string",
      "minLength": 1
    },
    "concern": {
      "type": "string",
      "minLength": 1
    },
    "stakeholder": {
      "type": "string"
    },
    "intent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "inspect",
          "compare",
          "understand",
          "decide",
          "create",
          "modify",
          "navigate",
          "monitor",
          "troubleshoot",
          "communicate",
          "trace"
        ]
      }
    },
    "informationStructure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "scalar",
          "list",
          "table",
          "hierarchy",
          "network",
          "hypergraph",
          "timeline",
          "sequence",
          "spatial",
          "document",
          "process",
          "state-machine",
          "matrix",
          "rules"
        ]
      }
    },
    "tasks": {
      "description": "What the reader does with the page. follow-trend: see how a measured value rises and falls over time (a weekly rate, a running total); it favours a line chart over lists that only hold time-stamped items.",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "lookup",
          "locate",
          "filter",
          "sort",
          "rank",
          "correlate",
          "trace",
          "aggregate",
          "annotate",
          "select",
          "enter",
          "confirm",
          "compare",
          "inspect",
          "edit",
          "simulate",
          "scrub",
          "decode-notation",
          "follow-trend"
        ]
      }
    },
    "itemDetail": {
      "description": "What selecting one item gives the reader. in-page: more about it on this page (fields, a record, a preview). link-out: only a link to somewhere else (a directory, an index of tools or documents). none: the row itself is everything. With link-out or none, views built around a detail pane are set aside: the pane would be empty.",
      "enum": ["in-page", "link-out", "none"]
    },
    "valueShape": {
      "description": "What each number the reader compares is. magnitude: an amount from zero up (a count, a cost, a score). signed: an effect that can go either way from zero (a change, a difference, a correlation), so the zero line and the direction matter. interval: an estimate with its uncertainty (a mean with a confidence interval, a forecast range), so the range must show, not only the point. Views that hide the sign or the range lose points.",
      "enum": ["magnitude", "signed", "interval"]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationshipEnds": {
      "description": "Optional: which object kinds each relationship joins, so the page plan can say what each kind reveals on click and how each link is drawn.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship", "from", "to"],
        "properties": {
          "relationship": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "directed": { "type": "boolean", "description": "false for a two-way link; omitted means it runs from -> to." }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focus": {
      "type": "string"
    },
    "explanatoryFocus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "structure",
          "mechanism",
          "transformation",
          "provenance",
          "comparison",
          "causality",
          "uncertainty",
          "state",
          "flow",
          "dataflow",
          "interface"
        ]
      },
      "uniqueItems": true
    },
    "surfaceContext": {
      "type": "object",
      "properties": {
        "repeatedCollection": {
          "type": "boolean"
        },
        "neighboringRepresentations": {
          "enum": [
            "homogeneous",
            "heterogeneous",
            "unknown"
          ]
        },
        "sharedInteractionGrammar": {
          "type": "boolean"
        },
        "medium": {
          "enum": [
            "application",
            "dashboard",
            "report",
            "technical-document",
            "presentation",
            "portfolio",
            "embedded-widget",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "scale": {
      "type": "object",
      "required": [
        "items",
        "density"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "density": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "links": {
          "description": "How many links the view draws between the items. A node-link or flow view's screen carries items plus links, so both count against the density budget.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": [
        "mode",
        "dynamics"
      ],
      "properties": {
        "mode": {
          "enum": [
            "read-only",
            "exploratory",
            "direct-manipulation",
            "authoring",
            "collaborative"
          ]
        },
        "dynamics": {
          "enum": [
            "static",
            "interactive",
            "animated",
            "simulated",
            "playback"
          ]
        }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "properties": {
        "expertise": {
          "enum": [
            "novice",
            "mixed",
            "expert"
          ]
        },
        "frequency": {
          "enum": [
            "one-off",
            "occasional",
            "high"
          ]
        },
        "domainFamiliarity": {
          "enum": [
            "novice",
            "mixed",
            "expert"
          ]
        },
        "notationFamiliarity": {
          "enum": [
            "novice",
            "mixed",
            "expert"
          ]
        },
        "visualizationLiteracy": {
          "enum": [
            "novice",
            "mixed",
            "expert"
          ]
        }
      },
      "additionalProperties": false
    },
    "semanticLenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "canonical",
              "source-derived",
              "interpretive",
              "practitioner-specific",
              "illustrative",
              "speculative"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "consequence": {
      "type": "object",
      "properties": {
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reversibility": {
          "enum": [
            "reversible",
            "partially-reversible",
            "irreversible"
          ]
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "mobile": {
          "type": "boolean"
        },
        "viewports": {
          "description": "Screens the page will be read on, in CSS pixels; the plan is budgeted for the one that holds the fewest objects.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "accessibility": {
          "enum": [
            "baseline",
            "high"
          ]
        },
        "realtime": {
          "type": "boolean"
        },
        "provenance": {
          "type": "boolean"
        },
        "allowAggregation": {
          "type": "boolean"
        },
        "scripts": {
          "description": "What the page may load: any (default); self-contained (one file, nothing fetched from another host or a running service, libraries inlined); none (must work with no JavaScript, e.g. a README, email or PDF).",
          "enum": [
            "any",
            "self-contained",
            "none"
          ]
        },
        "arrival": {
          "description": "How results reach the page: at-once (default); staged (named steps finish one after another, e.g. a pipeline run of 30-90 seconds); streaming (items keep arriving with no end).",
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "at-once",
                "staged",
                "streaming"
              ]
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "typicalSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "print": {
          "description": "The page must read correctly on paper or as a PDF.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modelData": {
      "type": "object",
      "description": "Optional instance-level data for renderer adapters. Shape is adapter-specific; when omitted, previews are explicitly schematic."
    },
    "representationRole": {
      "enum": [
        "explanatory",
        "operational",
        "analytic",
        "authoring",
        "audit"
      ]
    },
    "abstractionLevel": {
      "enum": [
        "caricature",
        "overview",
        "detailed"
      ]
    },
    "concernHierarchy": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assuranceRole": {
          "enum": [
            "secondary",
            "coequal",
            "primary"
          ]
        }
      },
      "additionalProperties": false
    },
    "semanticAvailability": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "present": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "learning": {
      "type": "object",
      "properties": {
        "entryMode": {
          "enum": [
            "guided",
            "practice",
            "reference",
            "assessment"
          ]
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "orientation",
              "recognition",
              "prediction",
              "discrimination",
              "composition",
              "transfer",
              "fluency"
            ]
          }
        },
        "scaffolding": {
          "enum": [
            "full",
            "fading",
            "minimal",
            "none"
          ]
        },
        "predictionBeforeReveal": {
          "type": "boolean"
        },
        "unseenTransfer": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "mustShow": {
      "description": "Parts the person named and expects to find on the page, in their words (for example each input category, each destination surface). Each one becomes a required disposition line shows:<part> whose satisfied answer must say where it is visible.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parts": {
      "description": "Sections of one page, in reading order. Each part is a use case for one section: it inherits every field of this page use case and overrides the ones it names (a shallow merge). A use case with parts gets one page plan across the sections (src/page-plan.mjs): one viewport and density budget per screen, one colour and shape per object kind on every section, and the gaps between sections.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "concern"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "concern": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
