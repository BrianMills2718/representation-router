{
  "version": "0.1",
  "methods": [
    {
      "id": "measured-svg-quality",
      "appliesTo": [
        "native-web",
        "d3"
      ],
      "when": [
        "svg",
        "custom-vector-visualization",
        "explorable-explanation"
      ],
      "workflow": [
        "render-with-final-fonts",
        "measure-rendered-geometry",
        "resolve-label-collisions",
        "route-around-obstacles",
        "validate-target-viewports",
        "human-composition-review",
        "capture-visual-regression"
      ],
      "hardChecks": [
        "no-critical-text-text-overlap",
        "no-critical-text-node-overlap",
        "no-clipped-required-labels",
        "no-required-controls-offscreen",
        "minimum-readable-font-size"
      ],
      "softChecks": [
        "edge-label-clearance",
        "arrowhead-clearance",
        "balanced-whitespace",
        "focal-hierarchy",
        "stable-layout-across-steps",
        "first-frame-legibility",
        "narrative-visual-synchronization",
        "persistent-object-continuity",
        "manipulation-consequence-legibility"
      ],
      "usabilityChecks": [
        "first-run-does-not-require-expert-exploration",
        "terms-are-defined-before-first-use",
        "one-new-semantic-distinction-per-instructional-step",
        "likely-wrong-readings-are-explicitly-disambiguated",
        "novice-can-read-a-simple-example-before-seeing-the-full-model",
        "expert-reference-mode-is-separate-from-guided-onboarding",
        "observed-user-confusions-become-regression-cases",
        "narrative-and-visual-state-remain-synchronized",
        "persistent-visual-object-retains-identity-across-steps",
        "direct-manipulation-produces-an-explanatory-consequence",
        "abstraction-levels-remain-linked-to-the-same-semantic-object",
        "if-constructive-practice-is-present-actions-come-from-semantic-model",
        "if-prediction-is-used-state-does-not-change-before-commit",
        "if-constructive-practice-is-present-feedback-explains-the-governing-rule",
        "if-transfer-assessment-is-present-guidance-does-not-give-away-the-answer",
        "if-transfer-assessment-is-present-at-least-one-task-uses-an-unseen-state-route-or-example",
