      "id": "canvas-webgl-quality",
      "appliesTo": [
        "sigma-js",
        "d3"
      ],
      "when": [
        "canvas",
        "webgl",
        "large-network"
      ],
      "workflow": [
        "compute-screen-space-label-budget",
