      "repairOrder": [
        "move-label-to-candidate-anchor",
        "reroute-edge",
        "increase-spacing-or-container-size",
        "shorten-secondary-label",
        "move-secondary-detail-to-inspector",
        "never-fix-by-unreadably-shrinking-text"
      ]
    },
    {
      "id": "graph-diagram-quality",
      "appliesTo": [
        "react-flow",
        "cytoscape-js",
        "elkjs",
        "graphviz"
      ],
      "when": [
        "graph",
        "hierarchy",
        "architecture",
        "state"
      ],
      "workflow": [
        "measure-node-content",
        "layout-with-real-node-dimensions",
        "route-edges",
        "place-edge-labels",
        "audit-crossings-and-overlaps",
        "validate-focus-and-selection",
        "human-composition-review",
        "capture-visual-regression"
      ],
      "hardChecks": [
        "no-node-overlap",
        "no-critical-label-overlap",
        "labels-fit-node-bounds",
        "ports-and-arrowheads-clear",
        "selected-path-remains-legible"
