{
  "version": "0.1",
  "methods": [
    {
      "id": "document-table-quality",
      "appliesTo": [
        "markdown"
      ],
      "when": [
        "table",
        "documentation"
      ],
      "workflow": [
        "render-in-the-target-viewer",
        "read-each-row-against-its-source",
        "check-target-width",
        "cold-reader-lookup",
        "capture-visual-regression"
      ],
      "hardChecks": [
        "header-row-names-every-condition-and-the-outcome",
        "rows-follow-the-order-the-source-applies-them",
        "caption-or-lead-line-says-how-a-row-is-chosen",
        "every-cell-readable-without-hover-or-horizontal-scroll-at-the-target-width",
        "table-renders-in-the-target-markdown-viewer",
        "outcomes-quote-the-exact-text-or-value-the-source-produces"
      ],
      "softChecks": [
        "one-condition-phrased-the-same-way-in-every-row",
        "gaps-and-overlaps-between-rows-named-in-the-text",
        "rows-that-write-or-change-state-marked"
      ],
      "usabilityChecks": [],
      "repairOrder": [
        "split-a-wide-table-or-move-long-cells-to-numbered-notes",
        "reorder-rows-to-the-source-order",
        "add-the-how-a-row-is-chosen-line",
        "replace-paraphrased-outcomes-with-exact-text"
      ]
    },
    {
      "id": "web-table-quality",
      "appliesTo": [
        "native-web"
      ],
      "requiresMatch": true,
      "when": [
        "table"
      ],
      "workflow": [
        "render-at-each-target-width",
        "look-up-three-rows-cold",
        "sort-and-filter-then-read-the-state",
        "capture-visual-regression"
      ],
      "hardChecks": [
        "header-row-names-every-column-and-its-unit",
        "every-cell-readable-without-hover-at-the-target-width",
        "no-page-level-horizontal-overflow",
        "numbers-right-aligned-in-one-format",
        "active-sort-and-filter-shown-in-words",
        "empty-and-failed-states-say-so-in-words"
      ],
      "softChecks": [
        "first-column-names-the-row",
        "rows-ordered-by-the-question-not-by-storage",
        "on-a-phone-a-row-becomes-a-labelled-card-instead-of-a-squeezed-row",
        "links-say-where-they-go"
      ],
      "usabilityChecks": [],
      "repairOrder": [
        "drop-or-hide-columns-the-question-does-not-need",
        "reflow-rows-to-cards-at-phone-width",
        "align-and-format-numbers",
        "state-sort-and-filter-above-the-table"
      ]
    },
    {
