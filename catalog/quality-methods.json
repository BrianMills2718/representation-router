      "softChecks": [
        "reasonable-line-length",
        "stable-generated-layout",
        "theme-contrast",
        "first-frame-legibility"
      ],
      "repairOrder": [
        "change-diagram-orientation",
        "split-view",
        "shorten-display-labels-with-full-text-in-source",
        "switch-layout-engine-or-representation"
      ]
    },
    {
      "id": "application-layout-quality",
      "appliesTo": [
        "native-web",
        "tldraw",
        "eclipse-glsp",
        "sirius-web"
      ],
      "when": [
        "application-ui",
        "editor",
        "composite-view"
      ],
      "workflow": [
        "layout-at-target-widths",
        "measure-control-and-text-bounds",
        "check-scroll-containment",
        "check-focus-order",
        "check-empty-and-max-content",
        "human-composition-review",
        "capture-visual-regression"
