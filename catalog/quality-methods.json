        "render",
        "inspect-generated-layout",
        "check-label-fit",
        "check-crossings",
        "test-theme-and-viewport",
        "human-composition-review",
        "capture-visual-regression"
      ],
      "hardChecks": [
        "no-clipped-labels",
        "no-unreadable-generated-overlap",
        "source-remains-reviewable"
